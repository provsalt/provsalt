---
import "@/styles/global.css";
import i18n from "i18next";
import { buildStaticPaths } from "astro-react-i18next/utils";
import { Hero } from "@/components/hero/hero";
import { Divider } from "@/components/ui/divider";
import { Code } from "@/components/code/code";
import { Travel } from "@/components/travel/travel";
import { TravelMap } from "@/components/travel/map.tsx";
import { About } from "@/components/about/about";
import { Sidebar } from "@/components/sidebar/sidebar";

export function getStaticPaths() {
	return buildStaticPaths();
}
---

<html lang={i18n.language}>
	<head>
		<meta charset="utf-8" />
		<!--<link rel="icon" type="image/svg+xml" href="/favicon.svg" />-->
		<!--<link rel="icon" href="/favicon.ico" />-->
		<meta name="description" content="Raymond Goo's website. Find out more about this person here!" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="viewport" content="width=device-width" />
		<title>Raymond Goo's Website</title>
	</head>
	<body class="flex flex-col min-h-svh">
		<div class="fixed right-0 top-0 h-full z-100">
			<Sidebar client:idle />
		</div>
		<div class="p-4 pt-8 md:pt-12 md:p-8 flex-1 flex flex-col gap-10">

			<Hero />
			<Divider />
			<Code client:load />
			<Travel />

			<div class="px-4">
				<TravelMap client:only="react">
					<div slot="fallback">Loading</div>
				</TravelMap>
			</div>

			<About client:idle />
		</div>
	</body>
</html>