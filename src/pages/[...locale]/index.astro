---
import { buildStaticPaths } from "astro-react-i18next/utils";
import { getCollection } from "astro:content";
import BlogSection from "@/components/blog/blog-section.astro";
import { Hero } from "@/components/hero/hero";
import { Divider } from "@/components/ui/divider";
import { Code } from "@/components/code/code";
import { Travel } from "@/components/travel/travel";
import { TravelMap } from "@/components/travel/map.tsx";
import { About } from "@/components/about/about";
import { Photograph } from "@/components/photo/photo.tsx";
import SiteLayout from "@/layouts/site-layout.astro";
import {
	getLocalizedPosts,
	getPublishedBlogPairs,
	normalizeBlogLocale,
} from "@/lib/blog";

export function getStaticPaths() {
	return buildStaticPaths();
}

const locale = normalizeBlogLocale(Astro.params.locale);
const posts = getLocalizedPosts(
	getPublishedBlogPairs(await getCollection("blog")),
	locale,
);
const localePaths = { en: "/", ja: "/ja/" };
const description =
	locale === "ja"
		? "レイモンド・グーの個人サイト。ソフトウェア、旅、写真、文章を紹介しています。"
		: "Raymond Goo's personal site, featuring software, travel, photography, and writing.";
---

<SiteLayout
	locale={locale}
	title="Raymond Goo"
	description={description}
	canonicalPath={locale === "ja" ? "/ja/" : "/"}
	localePaths={localePaths}
>
	<Hero />
	<Divider />
	<Code client:load />
	<BlogSection locale={locale} posts={posts} />
	<Travel />

	<div class="px-4">
		<TravelMap client:only="react">
			<div slot="fallback">Loading</div>
		</TravelMap>
	</div>

	<Photograph client:visible />
	<About client:idle />
</SiteLayout>
